{
  "name": "simple-bisnis",
  "version": "1.0.0",
  "private": true,
  "description": "Cyber Network Platform dengan Firebase, Map, Notification, Payment, dan UI Modern",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:full": "concurrently \"vite\" \"firebase emulators:start\"",
    "build:vercel": "vite build --outDir dist",
    "serve": "vite preview --port 3000 --host",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "firebase:deploy": "firebase deploy",
    "firebase:emulators": "firebase emulators:start",
    "test": "react-scripts test",
    "lint": "eslint src --ext js,jsx",
    "format": "prettier --write src/**/*.{js,jsx}",
    "generate-sw": "workbox generateSW workbox-config.js",
    "notifications:setup": "node scripts/setup-notifications.js",
    "payment:setup": "node scripts/setup-payment.js",
    "map:build": "node scripts/build-map-assets.js",
    "build:production": "NODE_ENV=production npm run build",
    "analyze": "source-map-explorer 'dist/assets/*.js'",
    "vercel:deploy": "vercel --prod",
    "vercel:dev": "vercel dev",
    "backup:data": "node scripts/backup-firebase.js",
    "restore:data": "node scripts/restore-firebase.js",
    "clear:cache": "rm -rf node_modules/.cache && rm -rf dist",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "security:check": "npm audit && npx snyk test",
    "update:deps": "npx npm-check-updates -u && npm install"
  },
